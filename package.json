{
  "name": "@waylake/devonthink3-mcp",
  "version": "0.3.0",
  "description": "Scoped, local MCP access to DEVONthink 3 on macOS",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devonthink3-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "docs/",
    "mcp.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": ["mcp", "devonthink", "pi-package", "macos", "knowledge-management"],
  "pi": { "mcp": "./mcp.json", "extensions": [], "skills": [] },
  "publishConfig": { "access": "public" },
  "scripts": {
    "start": "node src/index.js",
    "doctor": "node src/index.js --doctor",
    "test": "node --test test/contract.test.js",
    "test:live": "node --test test/live.test.js",
    "check": "node --check src/jxa.js && node --test test/contract.test.js",
    "bench": "node scripts/benchmark.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waylake/devonthink3-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
